{
	"name": "adrianduffell/wc-clearance",
	"description": "Move old stock easily by adding a dedicated clearance section to WooCommerce.",
	"type": "wordpress-plugin",
	"license": "GPL-3.0-only",
	"authors": [
		{
			"name": "Adrian Duffell",
			"homepage": "https://adrianduffell.com"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^2.0",
		"phpunit/phpunit": "^9.6"
	},
	"config": {
		"optimize-autoloader": true
	},
	"scripts": {
		"post-install-cmd": [
			"curl -L https://raw.githubusercontent.com/woocommerce/woocommerce/trunk/plugins/woocommerce/tests/legacy/framework/helpers/class-wc-helper-product.php -o vendor/class-wc-helper-product.php"
		]
	}
}
