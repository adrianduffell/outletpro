<?xml version="1.0"?>
<ruleset name="WC_Outlet">
	<description>PHP CodeSniffer ruleset for Outlet plugin.</description>

	<!-- Files to check -->
	<file>.</file>

	<!-- Only scan PHP files -->
	<arg name="extensions" value="php" />

	<!-- Exclude directories -->
	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>

	<rule ref="Squiz.Commenting.FunctionComment">
		<exclude-pattern>tests/</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.ClassComment">
		<exclude-pattern>tests/</exclude-pattern>
	</rule>

	<!-- Use WordPress Coding Standards -->
	<rule ref="WordPress">
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>tests/</exclude-pattern>
	</rule>

	<!-- Set minimum supported WordPress version for deprecation checks -->
	<config name="minimum_supported_wp_version" value="6.9" />

	<!-- Set minimum supported PHP version for compatibility checks -->
	<config name="testVersion" value="7.4-" />

	<!-- Declare WooCommerce custom capabilities -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_products" />
			</property>
		</properties>
	</rule>

	<!-- Set text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="outletpro" />
			</property>
		</properties>
	</rule>

	<!-- Slevomat Coding Standard rules -->

	<!-- Require return type hints -->
	<rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint" />

	<!-- Require parameter type hints -->
	<rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint" />

	<!-- Require property type hints -->
	<rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint" />

	<!-- Detect unused use statements -->
	<rule ref="SlevomatCodingStandard.Namespaces.UnusedUses" />

	<!-- Require alphabetically sorted use statements -->
	<rule ref="SlevomatCodingStandard.Namespaces.AlphabeticallySortedUses" />

	<!-- Require null coalesce operator (??) where applicable -->
	<rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceOperator" />

	<!-- Require short ternary operator (?:) where applicable -->
	<rule ref="SlevomatCodingStandard.ControlStructures.RequireShortTernaryOperator" />

	<!-- Complexity checks -->
	<rule ref="SlevomatCodingStandard.ControlStructures.EarlyExit" />

	<!-- Disallow nesting in tests -->
	<rule ref="Generic.Metrics.NestingLevel">
		<include-pattern>tests/</include-pattern>
		<exclude-pattern>tests/test-seed-outlet-status-taxonomy.php</exclude-pattern>
		<exclude-pattern>tests/test-set-outlet.php</exclude-pattern>
		<exclude-pattern>tests/test-add-to-outlet.php</exclude-pattern>
		<properties>
			<property name="absoluteNestingLevel" value="0" />
		</properties>
	</rule>
</ruleset>
