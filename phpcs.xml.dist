<?xml version="1.0"?>
<ruleset name="WC Clearance">
	<description>PHP CodeSniffer ruleset for WC Clearance plugin.</description>

	<!-- Files to check -->
	<file>.</file>

	<!-- Only scan PHP files -->
	<arg name="extensions" value="php" />

	<!-- Exclude directories -->
	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>

	<!-- Use WordPress Coding Standards -->
	<rule ref="WordPress" />

	<!-- Set minimum supported WordPress version for deprecation checks -->
	<config name="minimum_supported_wp_version" value="6.9" />

	<!-- Set text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wc-clearance" />
			</property>
		</properties>
	</rule>

	<!-- Slevomat Coding Standard rules -->

	<!-- Require trailing commas in multi-line arrays -->
	<rule ref="SlevomatCodingStandard.Arrays.TrailingArrayComma" />

	<!-- Require short type hints (bool not boolean, int not integer, etc.) -->
	<rule ref="SlevomatCodingStandard.TypeHints.LongTypeHints" />

	<!-- Normalize type casts (e.g. (bool) not (boolean)) -->
	<rule ref="SlevomatCodingStandard.PHP.TypeCast" />

	<!-- Require null coalesce operator (??) where applicable -->
	<rule ref="SlevomatCodingStandard.ControlStructures.RequireNullCoalesceOperator" />

	<!-- Detect useless if conditions with return -->
	<rule ref="SlevomatCodingStandard.ControlStructures.UselessIfConditionWithReturn" />
</ruleset>
