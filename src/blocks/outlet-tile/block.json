{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "outletpro/outlet-tile",
	"title": "Outlet Tile",
	"category": "woocommerce",
	"parent": [ "outletpro/outlet-tiles" ],
	"description": "A tile that links to all outlet products in the selected category.",
	"attributes": {
		"style": {
			"type": "object",
			"default": {
				"border": {
					"color": "#000000",
					"style": "solid",
					"width": "1px"
				},
				"dimensions": {
					"minHeight": "200px"
				},
				"typography": {
					"textDecoration": "none"
				},
				"spacing": {
					"blockGap": "0",
					"padding": {
						"left": "0.75em",
						"right": "0.75em"
					}
				}
			}
		},
		"category": {
			"type": "integer",
			"role": "content",
			"default": 0
		},
		"displayOutletBadgeLabel": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"__experimentalStyle": {
			"spacing": {
				"blockGap": "0"
			}
		},
		"html": false,
		"align": [ "wide", "full" ],
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"background": true,
			"gradients": true,
			"text": true
		},
		"dimensions": {
			"aspectRatio": true,
			"height": true,
			"minHeight": true
		},
		"layout": {
			"allowEditing": true,
			"allowInheriting": false,
			"allowJustification": true,
			"allowOrientation": true,
			"allowSwitching": true,
			"allowVerticalAlignment": true,
			"default": {
				"type": "flex",
				"orientation": "vertical",
				"verticalAlignment": "center"
			}
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"__experimentalFontFamily": true,
			"__experimentalFontStyle": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextDecoration": true,
			"__experimentalTextTransform": true
		}
	},
	"textdomain": "outletpro"
}
