{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wc-clearance/clearance-message",
	"title": "Clearance Message",
	"category": "woocommerce",
	"description": "Displays a message when a product is in the clearance section.",
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalFontWeight": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"message": {
			"type": "string",
			"default": "Not eligible for change of mind returns"
		},
		"fontSize": {
			"type": "string",
			"default": "small"
		}
	},
	"style": "file:./style.css",
	"textdomain": "wc-clearance"
}
