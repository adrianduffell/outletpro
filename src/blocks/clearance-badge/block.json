{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wc-clearance/clearance-badge",
	"title": "Clearance Badge",
	"category": "woocommerce",
	"description": "Displays a badge when a product is in the clearance section.",
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"spacing": {
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontWeight": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true
		}
	},
	"attributes": {
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"padding": {
						"top": "5px",
						"right": "5px",
						"bottom": "5px",
						"left": "5px"
					}
				},
				"typography": {
					"fontSize": "0.875rem",
					"fontWeight": "600"
				},
				"border": {
					"radius": "2px"
				}
			}
		}

	},
	"textdomain": "wc-clearance"
}
