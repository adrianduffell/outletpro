{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "outletpro/outlet-tiles",
	"title": "Outlet Tiles",
	"category": "woocommerce",
	"description": "Add tiles to help customers browse the most important categories in the outlet.",
	"allowedBlocks": [ "outletpro/outlet-tile" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"blockGap": true,
			"padding": true,
			"margin": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"layout": {
			"default": {
				"type": "grid",
				"columnCount": 3
			},
			"allowEditing": true
		}
	},
	"textdomain": "outletpro",
	"attributes": {
		"style": {
			"type": "object",
			"default": {
				"spacing": {
					"blockGap": "1em"
				}
			}
		}
	}
}
