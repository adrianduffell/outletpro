{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "outletpro/outlet-message",
	"title": "Outlet Message",
	"category": "woocommerce",
	"description": "Displays a message when a product is in the store’s outlet.",
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"spacing": {
			"margin": true
		},
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontWeight": true
		}
	},
	"textdomain": "outletpro"
}
