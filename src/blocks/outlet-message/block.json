{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "outletpro/outlet-message",
	"title": "Outlet Message",
	"category": "woocommerce",
	"description": "Displays a message when a product is in the store’s outlet.",
	"usesContext": [ "postId" ],
	"attributes": {
		"showIcon": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true,
			"blockGap": true
		},
		"layout": {
			"default": { "type": "flex", "flexWrap": "nowrap" },
			"allowEditing": false
		},
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontWeight": true
		}
	},
	"textdomain": "outletpro"
}
