{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "outletpro/outlet-menu",
	"title": "Outlet Menu",
	"category": "woocommerce",
	"description": "Displays a menu for the outlet page.",
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"anchor": true,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"__experimentalTextDecoration": true
		},
		"layout": {
			"allowEditing": true,
			"allowInheriting": false,
			"allowJustification": true,
			"allowOrientation": true,
			"allowSwitching": false,
			"allowVerticalAlignment": true,
			"default": {
				"type": "flex",
				"flexWrap": "wrap"
			}
		}
	},
	"textdomain": "outletpro",
	"attributes": {
		"style": {
			"type": "object",
			"default": {
				"typography": {
					"textDecoration": "none",
					"fontSize": "var(--wp--preset--font-size--medium)"
				},
				"spacing": {
					"blockGap": "1em",
					"padding": {
						"top": "0",
						"right": "0",
						"bottom": "0",
						"left": "0"
					}
				}
			}
		},
		"showAll": {
			"type": "boolean",
			"default": false
		},
		"items": {
			"type": "array",
			"items": {
				"type": "integer",
				"minimum": 1
			}
		}
	}
}
