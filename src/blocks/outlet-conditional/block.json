{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "outletpro/outlet-conditional",
	"title": "Outlet Conditional",
	"category": "woocommerce",
	"description": "Displays contents for outlet products or on the outlet page.",
	"attributes": {
		"conditionType": {
			"type": "string",
			"enum": [ "product", "page" ],
			"default": "product"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"layout": {
			"allowEditing": true,
			"allowInheriting": false,
			"allowJustification": true,
			"allowOrientation": true,
			"allowSizingOnChildren": true,
			"allowSwitching": true,
			"allowVerticalAlignment": true,
			"default": {
				"type": "default"
			}
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true
		}
	},
	"editorStyle": "file:../../../assets/css/outlet-conditional-editor.css",
	"textdomain": "outletpro"
}
