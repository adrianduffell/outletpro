{
	"name": "wc-clearance",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:php": "vendor/bin/phpcs -s",
		"lint:php:fix": "vendor/bin/phpcbf",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"test:e2e": "wp-scripts test-playwright",
		"test:unit": "wp-scripts test-unit-js",
		"test:wp": "wp-env run tests-cli --env-cwd=wp-content/plugins/wc-clearance vendor/bin/phpunit",
		"typecheck": "tsc --noEmit",
		"wp-env": "wp-env"
	},
	"babel": {
		"presets": [
			"@wordpress/babel-preset-default"
		]
	},
	"jest": {
		"preset": "@wordpress/jest-preset-default",
		"setupFilesAfterEnv": [
			"@wordpress/jest-preset-default/scripts/setup-test-framework.js",
			"<rootDir>/tests/js/setup.js"
		]
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@wordpress/babel-preset-default": "^8.42.0",
		"@wordpress/e2e-test-utils-playwright": "^1.40.0",
		"@wordpress/env": "^10.39.0",
		"@wordpress/jest-preset-default": "^12.42.0",
		"@wordpress/scripts": "^31.5.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.9.3"
	}
}
