{
	"name": "outletpro",
	"version": "1.1.0-dev",
	"private": true,
	"license": "GPL-2.0-or-later",
	"type": "module",
	"engines": {
		"node": "24.21.0"
	},
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:css:fix": "wp-scripts lint-style --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:md-docs": "wp-scripts lint-md-docs",
		"lint:md-docs:fix": "wp-scripts lint-md-docs --fix",
		"lint:php": "vendor/bin/phpcs -s",
		"lint:php:fix": "vendor/bin/phpcbf",
		"plugin-zip": "wp-scripts plugin-zip && zip -d outletpro.zip outletpro/package.json outletpro/README.md",
		"plugin-zip:marketplace": "npm run plugin-zip && zip -d outletpro.zip outletpro/CHANGELOG.md && mv .marketplace outletpro && zip outletpro.zip outletpro/changelog.txt && mv outletpro .marketplace",
		"preprocess": "./bin/preprocess.sh",
		"preprocess:marketplace": "./bin/preprocess-marketplace.sh",
		"start": "wp-scripts start",
		"test:e2e": "wp-scripts test-playwright",
		"test:e2e:block": "THEME=twentytwentyfive STORE_PAGES=block npm run test:e2e",
		"test:e2e:classic": "THEME=storefront STORE_PAGES=shortcode npm run test:e2e",
		"test:unit": "npm run test:unit:jest && npm run test:unit:vitest",
		"test:unit:jest": "wp-scripts test-unit-jest --config jest.config.cjs",
		"test:unit:vitest": "wp-scripts test-unit-js",
		"test:wp": "wp-env run tests-cli --env-cwd=wp-content/plugins/outletpro vendor/bin/phpunit",
		"typecheck": "tsc --noEmit",
		"wp-env": "wp-env",
		"wp-scripts": "wp-scripts"
	},
	"babel": {
		"presets": [
			"@wordpress/babel-preset-default"
		]
	},
	"files": [
		"assets",
		"build",
		"CHANGELOG.md",
		"includes",
		"templates",
		"outletpro.php",
		"readme.txt",
		"LICENSE"
	],
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@playwright/test": "^1.60.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/jest": "^29.5.14",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@vitest/eslint-plugin": "^1.6.27",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/babel-preset-default": "^9.0.0",
		"@wordpress/block-editor": "^18.1.0",
		"@wordpress/blocks": "^16.2.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/core-data": "^8.2.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/e2e-test-utils-playwright": "^3.0.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/env": "^11.17.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/hooks": "^4.57.0",
		"@wordpress/html-entities": "^4.57.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/icons": "^18.0.0",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/plugins": "^7.57.0",
		"@wordpress/prettier-config": "^4.57.0",
		"@wordpress/scripts": "^36.1.0",
		"@wordpress/ui": "^0.24.0",
		"babel-jest": "^30.5.0",
		"eslint-plugin-jest": "^29.17.0",
		"jest": "^30.5.0",
		"jest-environment-jsdom": "^30.5.0",
		"jsdom": "^30.1.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	}
}
